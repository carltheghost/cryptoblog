# Copy to .env and fill in. .env is git-ignored. NEVER commit real keys.
# Paper mode needs none of these (market data is public).

# Live trading only (not enabled by default):
KALSHI_API_KEY_ID=your-api-key-uuid
KALSHI_PRIVATE_KEY=/absolute/path/to/kalshi_private_key.pem

# Optional overrides:
# KALSHI_BASE_URL=https://api.elections.kalshi.com/trade-api/v2
