from __future__ import annotations

import shutil
import uuid
from pathlib import Path
from typing import Any, Dict, Optional

from fastapi import FastAPI, File, Form, UploadFile, WebSocket, WebSocketDisconnect
from fastapi.middleware.cors import CORSMiddleware
from fastapi.responses import FileResponse, JSONResponse
from fastapi.staticfiles import StaticFiles
from pydantic import BaseModel

from core.event_bus import EventBus
from core.model_router import ModelRouter
from core.overagency import OverAgency

BASE_DIR = Path(__file__).resolve().parent
CONFIG_PATH = BASE_DIR / "config.json"
UPLOAD_DIR = BASE_DIR / "uploads"
MEMORY_DB = BASE_DIR / "memory" / "events.db"
STATIC_DIR = BASE_DIR / "static"

UPLOAD_DIR.mkdir(exist_ok=True)
MEMORY_DB.parent.mkdir(exist_ok=True)

app = FastAPI(title="Tumbo OverAgency", version="0.1.0")
app.add_middleware(
    CORSMiddleware,
    allow_origins=["*"],
    allow_methods=["*"],
    allow_headers=["*"],
)

bus = EventBus(MEMORY_DB)
router = ModelRouter(CONFIG_PATH)
overagency = OverAgency(bus, router)

app.mount("/static", StaticFiles(directory=STATIC_DIR), name="static")
app.mount("/uploads", StaticFiles(directory=UPLOAD_DIR), name="uploads")


class ChatRequest(BaseModel):
    message: str
    image_path: Optional[str] = None


class ConfigUpdate(BaseModel):
    text_model: Optional[str] = None
    vision_model: Optional[str] = None
    voice_model: Optional[str] = None
    ollama_url: Optional[str] = None


@app.get("/")
async def index() -> FileResponse:
    return FileResponse(STATIC_DIR / "index.html")


@app.get("/api/health")
async def health() -> Dict[str, Any]:
    return {
        "ok": True,
        "system": "Tumbo OverAgency",
        "ollama_available": await router.ollama_available(),
        "event_stats": bus.stats(),
    }


@app.get("/api/config")
async def get_config() -> Dict[str, Any]:
    return router.load_config()


@app.post("/api/config")
async def update_config(update: ConfigUpdate) -> Dict[str, Any]:
    changes = {k: v for k, v in update.model_dump().items() if v is not None}
    config = router.save_config(changes)
    bus.publish("CONFIG_UPDATED", "WebUI", {"changes": changes}, target="ModelRouterAgency")
    return config


@app.post("/api/load_models")
async def load_models() -> Dict[str, Any]:
    cfg = router.load_config()
    text = await router.warm_model(cfg.get("text_model"))
    vision = None
    if cfg.get("vision_model"):
        vision = await router.warm_model(cfg.get("vision_model"))
    bus.publish("MODELS_WARMED", "ModelRouterAgency", {"text": text, "vision": vision})
    return {"text": text, "vision": vision, "voice": cfg.get("voice_model", "browser-tts")}


@app.post("/api/upload")
async def upload(file: UploadFile = File(...)) -> Dict[str, Any]:
    safe_suffix = Path(file.filename or "upload.bin").suffix[:12]
    stored_name = f"up_{uuid.uuid4().hex[:12]}{safe_suffix}"
    dest = UPLOAD_DIR / stored_name
    with dest.open("wb") as out:
        shutil.copyfileobj(file.file, out)
    public_path = f"/uploads/{stored_name}"
    bus.publish(
        "FILE_UPLOADED",
        "WebUI",
        {
            "filename": file.filename,
            "stored_name": stored_name,
            "content_type": file.content_type,
            "public_path": public_path,
        },
        target="MemoryAgency",
    )
    return {"ok": True, "path": public_path, "filename": file.filename, "content_type": file.content_type}


@app.post("/api/chat")
async def chat(req: ChatRequest) -> Dict[str, Any]:
    if not req.message.strip():
        return {"error": "message is required"}
    result = await overagency.handle_message(req.message, image_path=req.image_path)
    return result


@app.post("/api/voice_upload")
async def voice_upload(audio: UploadFile = File(...), transcript: str = Form(default="")) -> Dict[str, Any]:
    safe_suffix = Path(audio.filename or "voice.webm").suffix[:12] or ".webm"
    stored_name = f"voice_{uuid.uuid4().hex[:12]}{safe_suffix}"
    dest = UPLOAD_DIR / stored_name
    with dest.open("wb") as out:
        shutil.copyfileobj(audio.file, out)
    bus.publish(
        "VOICE_UPLOADED",
        "WebUI",
        {"stored_name": stored_name, "transcript": transcript, "public_path": f"/uploads/{stored_name}"},
        target="MemoryAgency",
    )
    return {"ok": True, "path": f"/uploads/{stored_name}", "transcript": transcript}


@app.get("/api/events")
async def events(limit: int = 50) -> Dict[str, Any]:
    return {"events": bus.recent(limit), "stats": bus.stats()}


@app.get("/api/agency_tree")
async def agency_tree() -> Dict[str, Any]:
    return overagency.root.to_dict()


@app.websocket("/ws")
async def websocket_chat(ws: WebSocket) -> None:
    await ws.accept()
    try:
        while True:
            payload = await ws.receive_json()
            message = str(payload.get("message", ""))
            image_path = payload.get("image_path")
            result = await overagency.handle_message(message, image_path=image_path)
            await ws.send_json(result)
    except WebSocketDisconnect:
        bus.publish("WEBSOCKET_DISCONNECTED", "WebUI", {}, target="MemoryAgency")


if __name__ == "__main__":
    import uvicorn

    uvicorn.run("server:app", host="127.0.0.1", port=8000, reload=True)